{
  "name": "nijisanji-database",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "build:index": "node scripts/build-index.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "validate:data": "node scripts/validate-data.mjs",
    "validate:roster": "node scripts/check-roster.mjs",
    "sync:youtube": "node scripts/sync-youtube.mjs --full",
    "sync:youtube:state": "node scripts/sync-youtube.mjs",
    "test": "node --test scripts/*.test.mjs",
    "collect:profiles": "node scripts/collect-profiles.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.3",
    "vite": "^6.0.5"
  }
}
